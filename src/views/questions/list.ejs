<div class="container py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
      <h1 class="h3 mb-1">Questions</h1>
      <p class="text-muted mb-0">Manage question text, options, keywords, and correct answers.</p>
    </div>
    <a class="btn btn-primary" href="/questions/create">Create question</a>
  </div>

  <% const items = questions || []; %>

  <% if (items.length > 0) { %>
    <div class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col">#</th>
              <th scope="col">Question</th>
              <th scope="col">Options</th>
              <th scope="col">Correct answer</th>
              <th scope="col" class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach((question, index) => { %>
              <% const options = question.options || []; %>
              <% const keywords = question.keyword || []; %>
              <% const answer = options[question.correctAnswerIndex] || `Index ${question.correctAnswerIndex}`; %>
              <tr>
                <td><%= index + 1 %></td>
                <td>
                  <div class="fw-semibold"><%= question.text %></div>
                  <small class="text-muted"><%= question._id %></small>
                </td>
                <td><%= options.length %> option(s)</td>
                <td><%= answer %></td>
                <td>
                  <div class="d-flex flex-wrap justify-content-end gap-2">
                    <a class="btn btn-sm btn-outline-primary" href="/questions/<%= question._id %>">View</a>
                    <a class="btn btn-sm btn-outline-secondary" href="/questions/<%= question._id %>/edit">Edit</a>
                    <form method="POST" action="/questions/<%= question._id %>?_method=DELETE" onsubmit="return confirm('Delete this question?');">
                      <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } else { %>
    <div class="card shadow-sm">
      <div class="card-body text-center py-5">
        <h2 class="h5">No questions yet</h2>
        <p class="text-muted">Create your first question to start building quizzes.</p>
        <a class="btn btn-primary" href="/questions/create">Create question</a>
      </div>
    </div>
  <% } %>
</div>
